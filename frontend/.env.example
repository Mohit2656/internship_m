BACKEND_API_URL=http://localhost:8080

# Google Maps integrations and existing settings remain independent of the
# additional OpenStreetMap picker. Photo Maps links do not require an API key.

# Additional OpenStreetMap workplace picker; independent of Google Maps settings.
# Defaults to standard OSM tiles for normal interactive viewing, with visible
# attribution and browser caching. No bulk downloads or tile prefetching.
# Workplace search goes through the backend; WORKPLACE_SEARCH_BASE_URL is a
# backend-only setting. See WORKPLACE_SEARCH.md for search provider configuration.
# Follow https://operations.osmfoundation.org/policies/tiles/ and use a suitable
# OSM-derived tile provider for deployment traffic exceeding community capacity.
# Public browser settings only: never put a secret key in NEXT_PUBLIC variables.
# NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# For another provider, include its required attribution text and HTTPS link:
# NEXT_PUBLIC_OSM_TILE_PROVIDER_NAME=
# NEXT_PUBLIC_OSM_TILE_PROVIDER_URL=
